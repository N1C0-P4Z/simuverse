generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────

// Removed UserRole enum to allow dynamic roles

enum SimulationStatus {
  not_started
  active
  paused
  completed
  abandoned
}

enum SimulationInstanceStatus {
  not_started
  in_progress
  paused
  completed
  failed
  submitted_for_review
}

enum ActionType {
  calculation
  document_upload
  email_read
  email_reply
  message_sent
  decision_made
  case_submitted
  case_approved
  case_rejected
  system_event
  crisis_triggered
  evaluation_completed
}

enum TelemetryActionType {
  user_input
  system_action
  ai_response
  decision
  error
  state_change
}

enum Difficulty {
  very_low
  low
  medium
  easy
  hard
}

enum FileType {
  pdf
  docx
  xlsx
  png
  jpg
  txt
}

enum RequirementStatus {
  uploaded
  processing
  extracted
  active
  archived
}

enum TaskType {
  practice
  evaluation
}

enum TaskStatus {
  pending
  in_progress
  completed
  archived
}

enum NotificationType {
  simulation_completed
  feedback_received
  kpi_achieved
  kpi_failed
  course_assigned
  evaluation_ready
  system_alert
}

enum FileUploadType {
  ministry_requirement
  scenario_resource
  student_submission
  tech_sheet
}

enum DocumentType {
  case
  contract
  policy
  legal
  procedure
  other
}

enum ModuleType {
  communication
  tools
  documentation
  assessment
}

enum FamilyType {
  administration
  rrhh
  it
  entrepreneurship
}

enum PromptGenerationMode {
  template
  manual
  guided
}

// ── TechSheet Analysis Enums ──────────────────────────────────────

enum TechSheetCompetencyLevel {
  basic
  intermediate
  advanced
}

enum TechSheetTaskType {
  practice
  evaluation
}

enum TechSheetPromptType {
  system
  evaluation
  coaching
}

enum AssignmentStatus {
  pending
  in_progress
  completed
  expired
}

// ── Models ─────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid()) @db.VarChar(36)
  email         String   @unique @db.VarChar(255)
  password_hash String?  @db.VarChar(255)
  firebase_uid  String?  @unique @db.VarChar(128)
  name          String   @db.VarChar(255)
  role          String   @default("student") @db.VarChar(100)
  roleInfo      Role?    @relation(fields: [role], references: [name])
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  simulations                    Simulation[]
  simulation_instances           SimulationInstance[]
  practice_logs                  PracticeLogs[]
  telemetry_logs                 TelemetryLog[]
  assessments                    Assessment[]
  ministry_requirements_uploaded MinistryRequirement[] @relation("UploadedBy")
  notifications_received         Notification[]        @relation("Recipient")
  notifications_actor            Notification[]        @relation("Actor")
  file_uploads                   FileUpload[]
  terms_acceptances              UserTermsAcceptance[]
  course_teachers                CourseTeacher[]
  enrollment_attempts            EnrollmentAttempt[]
  session_rubric_reviews         SessionRubricReview[]

  @@index([email])
  @@index([created_at])
  @@map("users")
}

model TeacherGroup {
  id         Int      @id @default(autoincrement())
  teacher_id String   @db.VarChar(36)
  student_id String   @db.VarChar(36)
  created_at DateTime @default(now()) @db.Timestamp(0)

  @@unique([teacher_id, student_id])
  @@map("teacher_groups")
}

model Course {
  id               String   @id @default(uuid()) @db.VarChar(36)
  course_id        String   @unique @db.VarChar(36)
  title            String   @db.VarChar(255)
  description      String?  @db.Text
  category         String   @db.VarChar(100)
  categories       Json?
  modules          Json?
  ai_config        Json?
  eval_criteria    Json?
  crisis_events    Json?
  tech_sheet_id    Int?
  password_hash    String?  @db.VarChar(255)
  drive_folder_url String?  @db.Text
  is_active        Boolean  @default(true)
  created_by       String?  @db.VarChar(36)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  config                     CourseConfig?
  simulations                Simulation[]
  scenarios                  Scenario[]
  assessments                Assessment[]
  course_modules             CourseModule[]
  telemetry_logs             TelemetryLog[]
  simulation_instances       SimulationInstance[]
  ministry_requirements      MinistryRequirement[]
  kpis                       KPI[]
  tasks                      Task[]
  practice_logs              PracticeLogs[]
  file_uploads               FileUpload[]
  teachers                   CourseTeacher[]
  enrollment_attempts        EnrollmentAttempt[]
  course_endorsers           CourseEndorser[]
  course_simulated_companies CourseSimulatedCompany[]
  course_foundation_configs  CourseFoundationConfig[]
  course_sponsors            CourseSponsor[]
  course_rubrics             CourseRubric[]

  @@index([category])
  @@map("courses")
}

model CourseTeacher {
  id         Int      @id @default(autoincrement())
  course_id  String   @db.VarChar(36)
  teacher_id String   @db.VarChar(36)
  created_at DateTime @default(now())

  course  Course @relation(fields: [course_id], references: [id], onDelete: Cascade)
  teacher User   @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@unique([course_id, teacher_id])
  @@index([teacher_id])
  @@map("course_teachers")
}

model EnrollmentAttempt {
  id         Int      @id @default(autoincrement())
  student_id String   @db.VarChar(36)
  course_id  String   @db.VarChar(36)
  success    Boolean  @default(false)
  created_at DateTime @default(now())

  student User   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@index([student_id, course_id, created_at])
  @@map("enrollment_attempts")
}

model TermsVersion {
  id           Int       @id @default(autoincrement())
  version      String    @unique @db.VarChar(50)
  title        String    @db.VarChar(255)
  content      String    @db.Text
  is_current   Boolean   @default(false)
  published_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  acceptances UserTermsAcceptance[]

  @@map("terms_versions")
}

model UserTermsAcceptance {
  id               Int      @id @default(autoincrement())
  user_id          String   @db.VarChar(36)
  terms_version_id Int
  accepted_at      DateTime @default(now())

  user          User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  terms_version TermsVersion @relation(fields: [terms_version_id], references: [id], onDelete: Cascade)

  @@unique([user_id, terms_version_id])
  @@index([user_id])
  @@map("user_terms_acceptances")
}

model Simulation {
  id                  String           @id @default(uuid()) @db.VarChar(36)
  student_id          String           @db.VarChar(36)
  course_id           String           @db.VarChar(36)
  status              SimulationStatus @default(active)
  current_state       Json?
  progress_percentage Int              @default(0)
  started_at          DateTime         @default(now())
  paused_at           DateTime?
  completed_at        DateTime?
  updated_at          DateTime         @updatedAt
  score               Int?

  user           User           @relation(fields: [student_id], references: [id], onDelete: Cascade)
  course         Course         @relation(fields: [course_id], references: [id], onDelete: Cascade)
  telemetry_logs TelemetryLog[]
  assessments    Assessment[]

  @@index([student_id])
  @@index([course_id])
  @@index([status])
  @@index([started_at])
  @@map("simulations")
}

model Scenario {
  id                String     @id @default(uuid()) @db.VarChar(36)
  course_id         String     @db.VarChar(36)
  title             String     @db.VarChar(255)
  description       String?    @db.Text
  scenario_type     String?    @db.VarChar(100)
  categories        Json?
  difficulty        Difficulty @default(medium)
  content           Json?
  expected_outcomes Json?
  is_active         Boolean    @default(true)
  config            Json?
  sequence_index    Int        @default(1)
  agent_key         String?    @db.VarChar(50)
  prior_context     String?    @db.Text
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt

  course    Course               @relation(fields: [course_id], references: [id], onDelete: Cascade)
  instances SimulationInstance[]
  tasks     Task[]

  @@index([course_id, sequence_index])
  @@map("scenarios")
}

model SimulationInstance {
  id                  String                   @id @default(uuid()) @db.VarChar(36)
  student_id          String                   @db.VarChar(36)
  scenario_id         String                   @db.VarChar(36)
  course_id           String                   @db.VarChar(36)
  status              SimulationInstanceStatus @default(not_started)
  progress_percentage Int                      @default(0)
  score               Float?
  feedback            String?                  @db.Text
  time_spent_seconds  Int?
  session_state       Json?
  practice_summary    String?                  @db.Text
  started_at          DateTime                 @default(now())
  completed_at        DateTime?
  updated_at          DateTime                 @updatedAt

  student       User           @relation(fields: [student_id], references: [id], onDelete: Cascade)
  course        Course         @relation(fields: [course_id], references: [id], onDelete: Cascade)
  scenario      Scenario       @relation(fields: [scenario_id], references: [id])
  logs                  PracticeLogs[]
  notifications         Notification[]
  file_uploads          FileUpload[]
  session_rubric_review SessionRubricReview?

  @@index([course_id, student_id])
  @@map("simulation_instances")
}

model Assessment {
  id                String    @id @default(uuid()) @db.VarChar(36)
  simulation_id     String    @db.VarChar(36)
  user_id           String    @db.VarChar(36)
  course_id         String    @db.VarChar(36)
  created_at        DateTime  @default(now())
  completed_at      DateTime?
  kpis              Json
  ai_evaluation     String?   @db.Text
  recommendation    String?   @db.Text
  digital_signature String?   @db.VarChar(64)
  feedback          Json?

  simulation Simulation @relation(fields: [simulation_id], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@index([simulation_id])
  @@index([user_id])
  @@index([course_id])
  @@index([created_at])
  @@map("assessments")
}

model PracticeLogs {
  id                     String     @id @default(uuid()) @db.VarChar(36)
  student_id             String     @db.VarChar(36)
  course_id              String     @db.VarChar(36)
  simulation_instance_id String?    @db.VarChar(36)
  action_type            ActionType
  description            String     @db.Text
  metadata               Json
  sequence_number        Int
  integrity_hash         String     @db.VarChar(64)
  previous_hash          String?    @db.VarChar(64)
  created_at             DateTime   @default(now())
  timestamp              BigInt
  docenter_notes         String?    @db.Text

  student             User                @relation(fields: [student_id], references: [id], onDelete: Cascade)
  course              Course              @relation(fields: [course_id], references: [id], onDelete: Cascade)
  simulation_instance SimulationInstance? @relation(fields: [simulation_instance_id], references: [id])

  @@index([student_id, course_id])
  @@index([course_id, created_at])
  @@index([student_id, created_at])
  @@index([integrity_hash])
  @@map("practice_logs")
}

model TelemetryLog {
  id               String              @id @default(uuid()) @db.VarChar(36)
  simulation_id    String              @db.VarChar(36)
  user_id          String              @db.VarChar(36)
  course_id        String              @db.VarChar(36)
  action           String              @db.VarChar(255)
  action_type      TelemetryActionType
  created_at       DateTime            @default(now())
  response_time_ms Int
  metadata         Json?
  integrity_hash   String              @db.VarChar(64)

  simulation Simulation @relation(fields: [simulation_id], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@index([simulation_id])
  @@index([user_id])
  @@index([course_id])
  @@index([created_at])
  @@index([action_type])
  @@map("telemetry_logs")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  code        String   @unique @db.VarChar(50)
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("categories")
}

model TechSheet {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(200)
  course_id        String    @db.VarChar(36)
  ministry_code    String?   @db.VarChar(100)
  description      String?   @db.Text
  competencies     Json?
  kpi_requirements Json?
  context_scenario String?   @db.Text
  extracted_data   Json?
  file_url         String?   @db.Text
  processed        Boolean   @default(false)
  processed_at     DateTime?
  uploaded_by      String?   @db.VarChar(36)
  created_at       DateTime  @default(now())
  pipeline_status  String?   @db.VarChar(50)
  pipeline_output  Json?

  course_configs   CourseConfig[]
  competencies_rel TechSheetCompetency[]
  kpis_rel         TechSheetKPI[]
  tasks_rel        TechSheetTask[]
  prompts_rel      TechSheetPrompt[]

  @@map("tech_sheets")
}

model TechSheetCompetency {
  id            String                   @id @default(uuid()) @db.VarChar(36)
  tech_sheet_id Int
  name          String                   @db.VarChar(255)
  description   String?                  @db.Text
  level         TechSheetCompetencyLevel @default(basic)
  category      String?                  @db.VarChar(100)
  created_at    DateTime                 @default(now())

  tech_sheet TechSheet @relation(fields: [tech_sheet_id], references: [id], onDelete: Cascade)

  @@index([tech_sheet_id])
  @@map("tech_sheet_competencies")
}

model TechSheetKPI {
  id                 String   @id @default(uuid()) @db.VarChar(36)
  tech_sheet_id      Int
  name               String   @db.VarChar(255)
  description        String?  @db.Text
  category           String?  @db.VarChar(100)
  weight             Float    @default(0)
  target_value       Float    @default(0)
  minimum_pass_value Float    @default(0)
  created_at         DateTime @default(now())

  tech_sheet TechSheet       @relation(fields: [tech_sheet_id], references: [id], onDelete: Cascade)
  tasks      TechSheetTask[]

  @@index([tech_sheet_id])
  @@map("tech_sheet_kpis")
}

model TechSheetTask {
  id                        String            @id @default(uuid()) @db.VarChar(36)
  tech_sheet_id             Int
  kpi_id                    String?           @db.VarChar(36)
  type                      TechSheetTaskType @default(evaluation)
  title                     String            @db.Text
  description               String?           @db.Text
  difficulty                Difficulty        @default(medium)
  sequence                  Int               @default(0)
  expected_duration_minutes Int               @default(0)
  created_at                DateTime          @default(now())

  tech_sheet TechSheet     @relation(fields: [tech_sheet_id], references: [id], onDelete: Cascade)
  kpi        TechSheetKPI? @relation(fields: [kpi_id], references: [id], onDelete: SetNull)

  @@index([tech_sheet_id])
  @@index([kpi_id])
  @@map("tech_sheet_tasks")
}

model TechSheetPrompt {
  id            String              @id @default(uuid()) @db.VarChar(36)
  tech_sheet_id Int
  type          TechSheetPromptType
  content       String              @db.Text
  created_at    DateTime            @default(now())

  tech_sheet TechSheet @relation(fields: [tech_sheet_id], references: [id], onDelete: Cascade)

  @@unique([tech_sheet_id, type])
  @@index([tech_sheet_id])
  @@map("tech_sheet_prompts")
}

model CourseDocument {
  id               Int          @id @default(autoincrement())
  course_id        String       @db.VarChar(36)
  document_name    String       @db.VarChar(200)
  document_type    DocumentType @default(other)
  document_content String?      @db.Text
  file_url         String?      @db.VarChar(500)
  uploaded_by      String?      @db.VarChar(36)
  is_active        Boolean      @default(true)
  created_at       DateTime     @default(now())

  @@map("course_documents")
}

model SimulationAssignment {
  id            Int              @id @default(autoincrement())
  simulation_id String           @db.VarChar(36)
  student_id    String           @db.VarChar(36)
  course_id     String           @db.VarChar(36)
  assigned_by   String           @db.VarChar(36)
  start_date    DateTime?
  end_date      DateTime?
  max_attempts  Int?             @default(1)
  status        AssignmentStatus @default(pending)
  attempts_used Int              @default(0)
  created_at    DateTime         @default(now())

  @@map("simulation_assignments")
}

model MinistryRequirement {
  id                String            @id @default(uuid()) @db.VarChar(36)
  course_id         String            @db.VarChar(36)
  uploaded_by_id    String?           @db.VarChar(36)
  file_name         String            @db.VarChar(255)
  file_type         FileType
  file_size_bytes   BigInt
  file_path         String            @db.VarChar(255)
  raw_text          String?           @db.Text
  extracted_content Json?
  status            RequirementStatus @default(uploaded)
  processing_notes  String?           @db.Text
  kpis_generated    Int               @default(0)
  tasks_generated   Int               @default(0)
  is_active         Boolean           @default(true)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  activated_at      DateTime?

  course       Course       @relation(fields: [course_id], references: [id], onDelete: Cascade)
  uploaded_by  User?        @relation("UploadedBy", fields: [uploaded_by_id], references: [id], onDelete: SetNull)
  kpis         KPI[]
  file_uploads FileUpload[]

  @@index([course_id])
  @@index([status])
  @@index([created_at])
  @@map("ministry_requirements")
}

model KPI {
  id                      String   @id @default(uuid()) @db.VarChar(36)
  course_id               String   @db.VarChar(36)
  ministry_requirement_id String?  @db.VarChar(36)
  name                    String   @db.VarChar(255)
  description             String   @db.Text
  category                String   @db.VarChar(50)
  weight                  Decimal  @default(1.0) @db.Decimal(5, 2)
  target_value            Decimal  @db.Decimal(5, 2)
  minimum_pass_value      Decimal  @default(80) @db.Decimal(5, 2)
  thresholds              Json
  prompt_instruction      String?  @db.Text
  trigger_event           String   @db.VarChar(100)
  success_criteria        String?  @db.Text
  is_active               Boolean  @default(true)
  tasks_count             Int      @default(0)
  students_achieved       Int      @default(0)
  created_at              DateTime @default(now())

  course               Course               @relation(fields: [course_id], references: [id], onDelete: Cascade)
  ministry_requirement MinistryRequirement? @relation(fields: [ministry_requirement_id], references: [id], onDelete: Cascade)
  tasks                Task[]

  @@index([course_id])
  @@index([ministry_requirement_id])
  @@index([is_active])
  @@map("kpis")
}

model Task {
  id                      String     @id @default(uuid()) @db.VarChar(36)
  course_id               String     @db.VarChar(36)
  kpi_id                  String     @db.VarChar(36)
  scenario_id             String?    @db.VarChar(36)
  title                   String     @db.VarChar(255)
  description             String     @db.Text
  type                    TaskType
  sequence_order          Int        @default(0)
  ai_prompt_config        Json?
  evaluation_criteria     Json?
  status                  TaskStatus @default(pending)
  is_active               Boolean    @default(true)
  students_completed      Int        @default(0)
  average_completion_rate Decimal    @default(0) @db.Decimal(5, 2)
  created_at              DateTime   @default(now())
  activated_at            DateTime?

  course   Course    @relation(fields: [course_id], references: [id], onDelete: Cascade)
  kpi      KPI       @relation(fields: [kpi_id], references: [id], onDelete: Cascade)
  scenario Scenario? @relation(fields: [scenario_id], references: [id], onDelete: SetNull)

  @@index([course_id])
  @@index([kpi_id])
  @@index([scenario_id])
  @@index([type])
  @@index([status])
  @@map("tasks")
}

model Notification {
  id                     String           @id @default(uuid()) @db.VarChar(36)
  recipient_id           String           @db.VarChar(36)
  actor_id               String?          @db.VarChar(36)
  simulation_instance_id String?          @db.VarChar(36)
  type                   NotificationType
  title                  String           @db.VarChar(255)
  content                String           @db.Text
  metadata               Json?
  is_read                Boolean          @default(false)
  read_at                DateTime?
  is_sent                Boolean          @default(false)
  created_at             DateTime         @default(now())

  recipient           User                @relation("Recipient", fields: [recipient_id], references: [id], onDelete: Cascade)
  actor               User?               @relation("Actor", fields: [actor_id], references: [id], onDelete: SetNull)
  simulation_instance SimulationInstance? @relation(fields: [simulation_instance_id], references: [id], onDelete: SetNull)

  @@index([recipient_id])
  @@index([type])
  @@index([is_read])
  @@index([created_at])
  @@map("notifications")
}

model FileUpload {
  id                      String         @id @default(uuid()) @db.VarChar(36)
  uploaded_by_id          String         @db.VarChar(36)
  course_id               String?        @db.VarChar(36)
  ministry_requirement_id String?        @db.VarChar(36)
  simulation_instance_id  String?        @db.VarChar(36)
  file_name               String         @db.VarChar(255)
  file_type               String         @db.VarChar(50)
  upload_type             FileUploadType
  file_size_bytes         BigInt
  file_path               String         @db.VarChar(255)
  file_hash               String?        @db.VarChar(64)
  description             String?        @db.Text
  is_active               Boolean        @default(true)
  created_at              DateTime       @default(now())

  uploaded_by          User                 @relation(fields: [uploaded_by_id], references: [id], onDelete: Cascade)
  course               Course?              @relation(fields: [course_id], references: [id], onDelete: SetNull)
  ministry_requirement MinistryRequirement? @relation(fields: [ministry_requirement_id], references: [id], onDelete: Cascade)
  simulation_instance  SimulationInstance?  @relation(fields: [simulation_instance_id], references: [id], onDelete: SetNull)
  sponsors             Sponsor[]

  @@index([uploaded_by_id])
  @@index([course_id])
  @@index([ministry_requirement_id])
  @@index([simulation_instance_id])
  @@index([created_at])
  @@map("file_uploads")
}

model CourseModule {
  id         String   @id @default(uuid()) @db.VarChar(36)
  course_id  String   @db.VarChar(36)
  module_id  String   @db.VarChar(36)
  order      Int      @default(0)
  created_at DateTime @default(now())

  course Course @relation(fields: [course_id], references: [id], onDelete: Cascade)
  module Module @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@index([course_id])
  @@index([module_id])
  @@map("course_modules")
}

model Module {
  id         String     @id @default(uuid()) @db.VarChar(36)
  name       String     @db.VarChar(255)
  type       ModuleType
  config     Json?
  created_at DateTime   @default(now())

  course_modules CourseModule[]

  @@index([name])
  @@map("modules")
}

model CourseConfig {
  id                     String               @id @default(uuid()) @db.VarChar(36)
  course_id              String               @unique @db.VarChar(36)
  config_data            Json
  base_role              String?              @db.Text
  course_context         String?              @db.Text
  personality_traits     Json?
  knowledge_base_prompt  String?              @db.Text
  active_modules         Json?
  ui_config              Json?
  ia_config              Json?
  family_type            FamilyType?
  calculator_config      Json?
  inbox_config           Json?
  validation_rules       Json?
  metadata               Json?
  tech_sheet_id          Int?
  prompt_template_id     Int?
  prompt_generation_mode PromptGenerationMode @default(template)
  prompt_generated_by    String?              @db.VarChar(36)
  prompt_generated_at    DateTime?
  tone                   String?              @db.VarChar(50)
  language               String?              @db.VarChar(30)
  role_behavior          String?              @db.Text
  chatbot_humano_enabled Boolean              @default(false)
  created_at             DateTime             @default(now())
  updated_at             DateTime             @updatedAt

  course          Course          @relation(fields: [course_id], references: [id], onDelete: Cascade)
  tech_sheet      TechSheet?      @relation(fields: [tech_sheet_id], references: [id])
  prompt_template PromptTemplate? @relation(fields: [prompt_template_id], references: [id])

  @@map("course_config")
}

