FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache openssl

COPY package.json package-lock.json ./

COPY apps/api-nest/package.json ./apps/api-nest/
COPY apps/web/package.json ./apps/web/
COPY proxy/package.json ./proxy/

ENV CYPRESS_INSTALL_BINARY=0

RUN npm ci

COPY apps/api-nest/prisma ./apps/api-nest/prisma/
COPY apps/api-nest/src/prisma/seed*.ts ./apps/api-nest/src/prisma/
# seed.ts optionally syncs users to Firebase Admin
COPY apps/api-nest/src/auth/firebase-credentials.ts ./apps/api-nest/src/auth/
COPY apps/api-nest/scripts/seed-gate.ts apps/api-nest/scripts/run-seeds-if-needed.sh ./apps/api-nest/scripts/
COPY apps/api-nest/tsconfig.json ./apps/api-nest/

RUN npx prisma generate --schema=apps/api-nest/prisma/schema.prisma

WORKDIR /app/apps/api-nest

RUN chmod +x scripts/run-seeds-if-needed.sh

ENV SEED_SUITE=prod

CMD sh -c " \
  echo '=== Seed gate (RUN_SEEDS='"'"'${RUN_SEEDS:-false}'"'"') ===' && \
  sh scripts/run-seeds-if-needed.sh && \
  echo '=== Seed step completed (ran or skipped) ===' \
"
